    "CHME3-EQ-PNEUMATIC-CONTROL-RESERVOIR",
    "CHME3-EQ-AIR-DRY-SEPARATOR",
    "CHME3-EQ-INTERCOOLER",
    "CHME3-EQ-REVERSER",
