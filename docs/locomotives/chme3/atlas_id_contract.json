    {"canonical":"CHME3-EQ-AUX-GENERATOR","aliases":["CHME3-EQ-AUXILIARY-GENERATOR","aux-generator"]},
    {"canonical":"CHME3-EQ-GOVERNOR","aliases":["CHME3-EQ-DIESEL-GOVERNOR","governor"]},
    {"canonical":"CHME3-EQ-OVERSPEED-GOV","aliases":["CHME3-EQ-OVERSPEED-GOVERNOR","overspeed-governor"]},
    {"canonical":"CHME3-EQ-FUEL-PRIME-PUMP","aliases":["CHME3-EQ-FUEL-PRIMING-PUMP","fuel-priming-pump"]},
    {"canonical":"CHME3-EQ-OIL-PRIME-PUMP","aliases":["CHME3-EQ-OIL-PRIMING-PUMP","oil-priming-pump"]},
    {"canonical":"CHME3-EQ-MAIN-RESERVOIRS","aliases":["CHME3-EQ-MAIN-RESERVOIR","main-reservoir"]},
    {"canonical":"CHME3T-EQ-BRAKE-RESISTORS","aliases":["CHME3T-EQ-BRAKING-RESISTORS","CHME3T-EQ-RHEOSTATS"]},
    {"canonical":"CHME3T-EQ-EDB-CONTROL","aliases":["CHME3T-EQ-RHEOSTATIC-BRAKE-CONTROL","CHME3T-EQ-DYNAMIC-BRAKE-CONTROL"]}
